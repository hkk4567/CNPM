# Địa chỉ backend mà điện thoại gọi tới. KHÔNG dùng localhost trên điện thoại thật.
#  - Điện thoại thật (cùng Wi-Fi với máy chạy backend): http://<IP máy tính>:3000/api   (xem IP bằng ipconfig / ifconfig)
#  - Máy ảo Android: http://10.0.2.2:3000/api    - Máy ảo iOS / bản web: http://localhost:3000/api
# Cũng có thể đổi ngay trong app ở màn Đăng nhập (mục "Máy chủ"), không cần build lại.
EXPO_PUBLIC_API_URL=http://192.168.1.22:3000/api